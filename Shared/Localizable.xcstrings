        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Behalte Brett, Stand und die noch offenen Karten im Blick"
          }
        }
      }
    },
    "Track the running total" : {
      "extractionState" : "manual",
      "localizations" : {
