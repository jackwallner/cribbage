    "Help us improve" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hilf uns, besser zu werden"
          }
        }
      }
    },
    "His nobs" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "His Nobs"
          }
        }
      }
    },
    "His nobs is one point for a jack matching the starter card's suit." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "His Nobs ist ein Punkt für einen Buben in der Farbe der Startkarte."
          }
        }
      }
    },
    "His nobs is one point for a jack whose suit matches the starter." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "His Nobs ist ein Punkt für einen Buben, dessen Farbe zur Startkarte passt."
          }
        }
      }
    },
    "Home and Your Progress show how many questions you locked in this week, so you can tell the practice is working." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Startbildschirm und „Dein Fortschritt“ zeigen, wie viele Fragen du diese Woche gefestigt hast. So siehst du, dass das Üben wirkt."
          }
        }
      }
    },
    "Home is the lobby. Each room holds its own drills: meet the deck, read the score, choose a discard, and peg to 31. All four beginner rooms are free, forever." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Startbildschirm ist die Lobby. Jeder Raum hat eigene Übungen: das Deck kennenlernen, Punkte lesen, abwerfen und bis 31 peggen. Alle vier Anfängerräume sind kostenlos, für immer."
          }
        }
      }
    },
    "How many cards are in the crib before the starter is cut?" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wie viele Karten liegen in der Crib, bevor die Startkarte abgehoben wird?"
          }
        }
      }
    },
    "How many cards does each player discard to the crib?" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wie viele Karten wirft jeder Spieler in die Crib?"
          }
        }
      }
    },
    "How many cards does each player receive before discarding?" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wie viele Karten bekommt jeder Spieler vor dem Abwerfen?"
          }
        }
      }
    },
    "How many points does a pair score?" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wie viele Punkte bringt ein Paar?"
          }
        }
      }
    },
    "How many points does a single combination totaling 15 score?" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wie viele Punkte bringt eine einzelne Kombination mit der Summe 15?"
          }
        }
      }
    },
    "How to Play" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "So wird gespielt"
          }
        }
      }
    },
    "If your hand contains a jack that matches the starter card's suit, score one point for his nobs. The jack does not need to match the starter's rank." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hast du einen Buben in der Farbe der Startkarte auf der Hand, gibt es einen Punkt für His Nobs. Der Rang der Startkarte muss dabei nicht passen."
          }
        }
      }
    },
    "Ignore it" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ignorieren"
          }
        }
      }
    },
    "Ignore the suits" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Farben ignorieren"
          }
        }
      }
    },
    "Included with %@" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In %@ enthalten"
          }
        }
      }
    },
    "Includes 7 days free. Auto-renews until canceled." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inklusive 7 Tage gratis. Verlängert sich automatisch bis zur Kündigung."
          }
        }
      }
    },
    "It joins both counts" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie zählt bei beiden"
          }
        }
      }
    },
    "J of %@" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@-Bube"
          }
        }
      }
    },
    "JOKER" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "JOKER"
          }
        }
      }
    },
    "Jacks, queens, and kings each have a cribbage value of 10, while their ranks stay distinct for pairs and runs." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Buben, Damen und Könige zählen beim Cribbage je 10, ihre Ränge bleiben für Paare und Folgen aber verschieden."
          }
        }
      }
    },
    "Join %@" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ beitreten"
          }
        }
      }
    },
    "Joker" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Joker"
          }
        }
      }
    },
    "K of %@" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@-König"
          }
        }
      }
    },
    "K-A-2" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "K-A-2"
          }
        }
      }
    },
    "KEEP IT LIT" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DRANBLEIBEN"
          }
        }
      }
    },
    "KNEW IT" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GEWUSST"
          }
        }
      }
    },
    "Keep 10-10-J-Q. The second 10 lets 10-jack-queen form twice, a double run of three for 6, plus 2 for the pair. Dropping the king breaks nothing, because 10-jack-queen-king would only be a single run of four, and the 4 connects to nothing here." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Behalte 10-10-J-Q. Durch die zweite 10 entsteht 10-Bube-Dame zweimal, eine doppelte Dreierfolge für 6, plus 2 für das Paar. Der König kann weg, denn 10-Bube-Dame-König wäre nur eine einfache Viererfolge, und die 4 passt hier zu nichts."
          }
        }
      }
    },
    "Keep 2-3-10-J: 2-3-10 and 2-3-jack are two fifteens, and the jack can still add his nobs. For this deal, throwing 7-8 gives the best combined average in the drill's random-discard model. They already make fifteen in your crib." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Behalte 2-3-10-J: 2-3-10 und 2-3-Bube sind zwei Fünfzehnen, und der Bube kann noch His Nobs bringen. In diesem Deal bringt der Abwurf von 7-8 im Zufallsabwurf-Modell der Übung den besten Gesamtschnitt. Die beiden ergeben in deiner Crib schon Fünfzehn."
          }
        }
      }
    },
    "Keep 2-3-4 with the 9: the run scores 3 and 2-4-9 makes fifteen. Holding the 9 rather than the 10 matters on the discard side, because 8 and 10 give the dealer nothing, while 8 and 9 hand over a run start." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Behalte 2-3-4 mit der 9: Die Folge bringt 3 und 2-4-9 ergibt Fünfzehn. Die 9 statt der 10 zu halten, zählt beim Abwurf, denn 8 und 10 geben dem Geber nichts, während 8 und 9 ihm den Anfang einer Folge schenken."
          }
        }
      }
    },
    "Keep 2-3-4-5 for a run of four. Trading the 5 away would be worse: it is the single most useful card in the deck, and as pone every card you throw lands in the dealer's crib. The 10 and king neither pair nor make fifteen together, so they are the cheapest pair to give up." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Behalte 2-3-4-5 für eine Viererfolge. Die 5 abzugeben wäre schlechter: Sie ist die nützlichste Karte im Deck, und als Vorhand landet jede abgeworfene Karte in der Crib des Gebers. Die 10 und der König bilden weder ein Paar noch eine Fünfzehn, also sind sie das billigste Paar zum Abgeben."
          }
        }
      }
    },
    "Keep 3-4-5-10, which is rich in runs and fifteens. The 9 and king are the least connected cards, and they do not make 15 together." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Behalte 3-4-5-10, reich an Folgen und Fünfzehnen. Die 9 und der König sind am wenigsten verbunden und ergeben zusammen nicht 15."
          }
        }
      }
    },
    "Keep 3-4-5-6: a run of four for 4, plus the 4-5-6 fifteen for 2. Swapping the 6 for the 10 looks similar but drops the run to three cards. The two ten-value cards neither pair nor make fifteen together, so they are the safest thing to hand the dealer." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Behalte 3-4-5-6: eine Viererfolge für 4 plus die Fünfzehn aus 4-5-6 für 2. Die 6 gegen die 10 zu tauschen sieht ähnlich aus, verkürzt die Folge aber auf drei Karten. Die zwei Zehnerkarten bilden weder ein Paar noch zusammen Fünfzehn und sind daher das Sicherste, was du dem Geber geben kannst."
          }
        }
      }
    },
    "Keep 4-5-6 with one 10: the run is 3, 4-5-6 makes fifteen, and 5 with the 10 makes another, for 7 points. Breaking the pair of 10s costs 2, but the 10 and queen make neither a pair nor a fifteen in the dealer's crib, and the 4-5-6 block is the shape most cuts improve." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Behalte 4-5-6 mit einer 10: Die Folge zählt 3, 4-5-6 ergibt Fünfzehn, und die 5 mit der 10 eine weitere, zusammen 7 Punkte. Das Paar 10er aufzugeben kostet 2, aber 10 und Dame bilden in der Crib des Gebers weder ein Paar noch eine Fünfzehn, und der Block 4-5-6 wird durch die meisten Startkarten besser."
          }
        }
      }
    },
    "Keep 5-10-J-Q. The 5 makes fifteen with each of the three ten-value cards, and 10-jack-queen is a run of three, so the hand counts 9 before the cut, with a jack that can add his nobs. The king and the 4 neither pair nor make fifteen together in the dealer's crib." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Behalte 5-10-J-Q. Die 5 ergibt mit jeder der drei Zehnerkarten Fünfzehn, und 10-Bube-Dame ist eine Dreierfolge. Die Hand zählt also 9 vor der Startkarte, mit einem Buben, der noch His Nobs bringen kann. König und 4 bilden in der Crib des Gebers weder ein Paar noch zusammen Fünfzehn."
          }
        }
      }
    },
    "Keep 5-5-10-Q. Each 5 makes fifteen with the 10 and again with the queen, so that is four fifteens for 8, plus 2 for the pair: 10 points before the cut. The 6 and 7 are connected ranks that may build a run in your own crib. They total 13, so they do not score a fifteen by themselves." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Behalte 5-5-10-Q. Jede 5 ergibt Fünfzehn mit der 10 und noch einmal mit der Dame, also vier Fünfzehnen für 8, plus 2 für das Paar: 10 Punkte vor der Startkarte. Die 6 und die 7 sind verbundene Ränge, die in deiner eigenen Crib eine Folge bilden können. Zusammen ergeben sie 13, also keine Fünfzehn für sich."
          }
        }
      }
    },
    "Keep 5-6-9-K for two fifteens: 6 with 9, and 5 with the king. Throwing the 2 and the 8 gives the dealer two cards that neither pair nor reach fifteen together, and it keeps the 5 out of the crib." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Behalte 5-6-9-K für zwei Fünfzehnen: 6 mit 9 und 5 mit dem König. Mit der 2 und der 8 bekommt der Geber zwei Karten, die weder ein Paar noch zusammen Fünfzehn ergeben, und die 5 bleibt aus der Crib."
          }
        }
      }
    },
    "Keep 6-6-7-8. The second 6 gives 6-7-8 two ways to form, a double run of three for 6, plus 2 for the pair and 2 for the 7-8 fifteen: 10 points before the cut. The 2 and the king touch none of that." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Behalte 6-6-7-8. Durch die zweite 6 entsteht 6-7-8 zweimal, eine doppelte Dreierfolge für 6, plus 2 für das Paar und 2 für die Fünfzehn aus 7 und 8: 10 Punkte vor der Startkarte. Die 2 und der König haben damit nichts zu tun."
          }
        }
      }
    },
    "Keep a pair?" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Paar behalten?"
          }
        }
      }
    },
    "Keep both" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beide behalten"
          }
        }
      }
    },
    "Keep cards that make several shapes" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Behalte Karten, die mehrere Muster bilden"
          }
        }
      }
    },
    "Keep connected ranks" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Behalte verbundene Ränge"
          }
        }
      }
    },
    "Keep going. Sharp means nearly everything here is holding." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mach weiter. „Sicher“ heißt, dass hier fast alles sitzt."
          }
        }
      }
    },
    "Keep it" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Behalten"
          }
        }
      }
    },
    "Keep practicing free" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kostenlos weiterüben"
          }
        }
      }
    },
    "Keep the 4-5-6 shape" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Behalte das Muster 4-5-6"
          }
        }
      }
    },
    "Keep the 5" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die 5 behalten"
          }
        }
      }
    },
    "Keep the disconnected 2" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Behalte die einzelne 2"
          }
        }
      }
    },
    "Keep the guaranteed pair" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Behalte das sichere Paar"
          }
        }
      }
    },
    "Keep the isolated queen" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Behalte die einzelne Dame"
          }
        }
      }
    },
    "Keep the pair" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Behalte das Paar"
          }
        }
      }
    },
    "Keep the pair of 4s and the 5-6 connection. The pair is guaranteed value, while 10 and queen are the least integrated cards in this deal." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Behalte das Paar 4er und die Verbindung 5-6. Das Paar ist sicherer Wert, während 10 und Dame die am wenigsten eingebundenen Karten dieses Deals sind."
          }
        }
      }
    },
    "Keeping A-A-6-8 counts 6 and A-A-5-8 counts 4, so the bigger hand is two points better. It is still the wrong choice: the cards it throws are a 5 and a queen, which already make fifteen in the crib you do not own. Throw the 6 and the queen instead and hand over nothing that scores by itself." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A-A-6-8 zählt 6 und A-A-5-8 zählt 4, die größere Hand ist also zwei Punkte besser. Trotzdem ist sie die falsche Wahl: Sie wirft eine 5 und eine Dame ab, die in der Crib, die dir nicht gehört, schon Fünfzehn ergeben. Wirf stattdessen die 6 und die Dame ab und gib nichts her, was allein punktet."
          }
        }
      }
    },
    "Keeping four matching cards gives a hand flush. A matching starter extends it to five. This pattern exercise does not designate a starter." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vier Karten gleicher Farbe ergeben einen Hand-Flush. Eine passende Startkarte macht fünf daraus. In dieser Musterübung gibt es keine festgelegte Startkarte."
          }
        }
      }
    },
    "Keeping the 7s with the 3 and 5 is the best hand that holds the pair, 6 points before the cut. Throwing the 7s keeps 3-4-5-10 for 5, a run plus the 5-10 fifteen, and puts a pair in your own crib, where it is worth about two points more than the 4 and 10 would be." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die 7er mit der 3 und der 5 zu behalten ist die beste Hand, die das Paar hält: 6 Punkte vor der Startkarte. Wirfst du die 7er ab, behältst du 3-4-5-10 für 5 Punkte, eine Folge plus die Fünfzehn aus 5 und 10, und legst ein Paar in deine eigene Crib. Dort ist es etwa zwei Punkte mehr wert, als die 4 und die 10 es wären."
          }
        }
      }
    },
    "Keeping the dealer's crib large" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Crib des Gebers groß halten"
          }
        }
      }
    },
    "Keeping the four clubs is 4 for the flush plus 2 for the 2-4-9 fifteen, and a club cut makes the flush 5. The 7 and king are off-suit, do not pair, and do not reach fifteen together, so they cost the dealer's crib very little." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die vier Kreuz zu behalten bringt 4 für den Flush plus 2 für die Fünfzehn aus 2-4-9, und eine Kreuz-Startkarte macht den Flush zu 5. Die 7 und der König haben eine andere Farbe, bilden kein Paar und ergeben zusammen nicht Fünfzehn. Sie kosten dich in der Crib des Gebers also kaum etwas."
          }
        }
      }
    },
    "Keeping the four hearts preserves a four-card flush and gives the starter a chance to extend it. The off-suit 4 and 9 do not create a stronger structure together, and neither is an appealing gift as a pair." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mit den vier Herz behältst du einen Flush aus vier Karten, und die Startkarte kann ihn noch verlängern. Die 4 und die 9 in anderen Farben ergeben zusammen nichts Stärkeres und sind auch als Paar kein verlockendes Geschenk."
          }
        }
      }
    },
    "Keeping the four suited cards would give a 4-point hand flush. A matching starter would make it 5; a crib flush always needs all five." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die vier Karten gleicher Farbe zu behalten ergäbe einen Hand-Flush für 4 Punkte. Eine passende Startkarte machte daraus 5. Ein Crib-Flush braucht immer alle fünf."
          }
        }
      }
    },
    "Knew it? Swipe right · Again? Swipe left" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gewusst? Nach rechts · Nochmal? Nach links"
          }
        }
      }
    },
    "Know the Scores" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Wertungen kennen"
          }
        }
      }
    },
    "Know the basics" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kenne die Grundlagen"
          }
        }
      }
    },
    "Know the deal, still slow on the count" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kenne den Ablauf, zähle noch langsam"
          }
        }
      }
    },
    "Know what to sharpen" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wisse, was du üben musst"
          }
        }
      }
    },
    "Know which cards make fifteens, spot scoring patterns fast, and stop dreading the discard. Practice at your own pace, with no opponents." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wisse, welche Karten Fünfzehn ergeben, erkenne Punktmuster schnell und hab keine Angst mehr vorm Abwerfen. Übe in deinem Tempo, ohne Gegner."
          }
        }
      }
    },
    "Know whose crib you are feeding before evaluating any discard." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wisse, wessen Crib du fütterst, bevor du einen Abwurf bewertest."
          }
        }
      }
    },
    "Knowing when to say go" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wissen, wann man Go sagt"
          }
        }
      }
    },
    "Known discards reduce the live copies of ranks and help you judge both hand potential and pegging danger." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bekannte Abwürfe verringern die noch offenen Karten eines Rangs und helfen dir, das Potenzial der Hand und die Gefahr beim Pegging einzuschätzen."
          }
        }
      }
    },
    "Last card" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Letzte Karte"
          }
        }
      }
    },
    "Learn the hand, one rep at a time" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lerne die Hand, eine Wiederholung nach der anderen"
          }
        }
      }
    },
    "Learned what I needed" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hab gelernt, was ich brauchte"
          }
        }
      }
    },
    "Learning" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
