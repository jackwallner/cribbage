    },
    "Cribbage Minute and a personalized Game Night Prep" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cribbage Minute und eine persönliche Spieleabend-Vorbereitung"
          }
        }
      }
    },
    "Cribbage Minute: Hand Read" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cribbage Minute: Hand lesen"
          }
        }
      }
    },
    "Cribbage Minute: The Discard" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cribbage Minute: Der Abwurf"
          }
