        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schaff eine Übung pro Tag und deine Serie wächst. Was du falsch hast, kommt leise wieder, bis du es sicher kannst."
          }
        }
      }
    },
    "Five minutes of practice keeps your discards calm and your count sharp." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fünf Minuten Übung halten deine Abwürfe ruhig und dein Zählen scharf."
