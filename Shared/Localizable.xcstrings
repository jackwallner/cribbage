    "Swipe through flashcards, read scoring shapes, make pegging calls, and choose two-card discards, with the why behind every answer." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wische durch Lernkarten, lies Punktmuster, triff Pegging-Entscheidungen und wähle Zwei-Karten-Abwürfe, mit dem Warum hinter jeder Antwort."
          }
        }
      }
    },
