          }
        }
      }
    },
    "Only the two 10s share a rank, so there is exactly one pair. Queen and king are also worth 10 toward a fifteen, but rank is what pairs, and 10-queen-king skips the jack so there is no run." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nur die zwei 10er haben denselben Rang, also gibt es genau ein Paar. Dame und König zählen für eine Fünfzehn ebenfalls 10, aber für Paare zählt der Rang, und 10-Dame-König überspringt den Buben, also keine Folge."
          }
        }
      }
    },
    "Only when the suits match" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
